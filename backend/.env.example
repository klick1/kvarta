DATABASE_URL=sqlite:////app/data/kvarta.db
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-long-random-string

# Дубликаты заявок (в секундах) — по ТЗ 10 минут
LEAD_DUPLICATE_TTL=600

# Анти-бот: форма должна быть открыта от 2 сек до 1 часа
BOT_MIN_SECONDS=2
BOT_MAX_SECONDS=3600

# Rate limit: не больше N заявок с одного IP в час
RATE_LIMIT_PER_HOUR=5

# CORS — фронт на Vercel (если не используешь rewrites)
CORS_ORIGINS=https://kvarta.vercel.app,http://localhost:3000

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=